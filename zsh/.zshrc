# source /nix/store/zh3d08d030ivpziy6f3g3xwxcsa7b9kd-zsh-autoenv-unstable-2017-12-16/share/zsh-autoenv/autoenv.zsh
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# source $HOME/.local/bin/env
eval "$(mise activate zsh)"

