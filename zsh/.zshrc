# Aliases
# alias -- 'pacup'='sudo pacman -Syu'

# alias -- 'hms'='home-manager switch --flake ~/git/jnix'
# alias -- 'ncg'='nix-collect-garbage -d'
# alias -- 'upd'='nix flake update ~/git/jnix'
# alias -- 'upg'='sudo nixos-rebuild switch --upgrade --flake ~/git/jnix'
# alias -- 'rb'='sudo nixos-rebuild switch --flake ~/git/jnix'

alias -- 'fc'='fzf | wl-copy'
alias -- 'ff'='fastfetch'
alias -- 'fresh'='exec $SHELL'
alias -- 'he'='helix ./'
alias -- 'kiro'='exec $KIRO_ROOT/kiro &'
alias -- 'lg'='lazygit'
alias -- 'lh'='ls -lah'
alias -- 'll'='ls -l'
alias -- 'nv'='nvim ./'
alias -- 'pip'='uv pip'
alias -- 'py'='python'
alias -- 'se'='sudoedit'
alias -- 'uvenv'='source .venv/bin/activate'
alias -- 'watts'='echo $(($(cat /sys/class/power_supply/BAT1/current_now) * $(cat /sys/class/power_supply/BAT1/voltage_now) / 1000000000000))W'

# Named Directory Hashes


# source /nix/store/ca3lm1a38jh8vn512is36y54dvr3hqn9-zsh-syntax-highlighting-0.8.0/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
# ZSH_HIGHLIGHT_HIGHLIGHTERS+=()

eval "$(starship init zsh)"

